{
  "name": "lazycat-app-backup-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-typescript ../../api/openapi/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/schema.d.ts",
    "build": "npm run api:check && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "autoprefixer": "latest",
    "postcss": "latest",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "3.4.17",
    "typescript": "latest",
    "vitest": "latest"
  }
}
